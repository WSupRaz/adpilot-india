# =============================================================================
# AdPilot India — Root Environment Variables Example
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# ---- DATABASE ----------------------------------------------------------------
DATABASE_URL="postgresql://adpilot:adpilot_dev@localhost:5432/adpilot_india"
DIRECT_URL="postgresql://adpilot:adpilot_dev@localhost:5432/adpilot_india"

# ---- REDIS ------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- AUTH -------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- AI PROVIDERS -----------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""

# Primary model per task (can be overridden per request)
AI_DEFAULT_PROVIDER="anthropic"
AI_FALLBACK_PROVIDER="openai"

# ---- PAYMENTS ---------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- MESSAGING --------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@adpilotindia.com"

MSG91_API_KEY=""
MSG91_SENDER_ID="ADPILT"
MSG91_TEMPLATE_ID_OTP=""

# ---- STORAGE ----------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="adpilot-india"
R2_PUBLIC_URL="https://pub.adpilotindia.com"

# ---- AD PLATFORMS (Phase 2) -------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

META_APP_ID=""
META_APP_SECRET=""
META_AD_LIBRARY_ACCESS_TOKEN=""

# ---- WHATSAPP (Phase 3) -----------------------------------------------------
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
WABA_PHONE_NUMBER_ID=""
WABA_ACCESS_TOKEN=""
WABA_VERIFY_TOKEN=""

# ---- MONITORING -------------------------------------------------------------
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ---- APP --------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"
