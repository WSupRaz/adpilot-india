{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate --schema=../database/schema.prisma",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "npx prisma generate --schema=../database/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=../database/schema.prisma",
    "db:push": "npx prisma db push --schema=../database/schema.prisma",
    "db:seed": "npx tsx ../database/seed.ts",
    "db:demo": "npx tsx ../database/demo-seed.ts",
    "db:studio": "npx prisma studio --schema=../database/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.1",
    "@aws-sdk/client-s3": "^3.623.0",
    "@aws-sdk/s3-request-presigner": "^3.623.0",
    "@google/generative-ai": "^0.16.0",
    "@prisma/client": "^5.17.0",
    "@sentry/node": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.10.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.53.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.4",
    "resend": "^3.4.0",
    "shared": "*",
    "stripe": "^16.2.0",
    "tsx": "^4.16.2",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.11",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "prisma": "^5.17.0",
    "typescript": "^5.5.4"
  }
}
